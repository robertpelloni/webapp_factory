{
  "name": "webapp_factory",
  "version": "4.3.0",
  "description": "Autonomous utility factory",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "start:all": "node src/tray.js --start-all",
    "stop": "node src/tray.js --quit",
    "tray": "node src/tray.js",
    "build:dashboard": "npm --prefix src/dashboard run build",
    "start:dashboard": "npm --prefix src/dashboard run start",
    "lint:dashboard": "npm --prefix src/dashboard run lint",
    "clean:logs": "node -e \"const fs = require('fs'); ['factory.log', 'error.log'].forEach(f => { if(fs.existsSync(f)) fs.writeFileSync(f, ''); }); console.log('Logs truncated.');\"",
    "test": "vitest run"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "node-cron": "^4.6.0",
    "pg": "^8.12.0",
    "playwright": "^1.45.1",
    "sqlite3": "^6.0.1",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "vitest": "^5.1.0"
  }
}
